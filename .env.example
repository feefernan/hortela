# Copie para .env.local (não versionado). Em CI, cadastre como GitHub Secrets/Variables.
# URL do Worker de pedidos (worker/), sem barra no fim. Ex.: https://hortela-pedidos.<conta>.workers.dev
VITE_ORDERS_API=

# Observabilidade (vazio = desligado)
VITE_SENTRY_DSN=
# Coletor OTLP/HTTP, ex.: https://otel.exemplo.com/v1/traces
VITE_OTEL_EXPORTER_URL=
# Preenchido pelo CI com o SHA do commit
VITE_RELEASE=
